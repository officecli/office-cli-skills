{
  "docx": {
    "agent_render_supported": true,
    "image_support": {
      "default_enabled": false
    },
    "payload_schema": {
      "additionalProperties": false,
      "properties": {
        "sections": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "heading": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              },
              "paragraphs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "heading",
              "level",
              "paragraphs"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "sections"
      ],
      "type": "object"
    },
    "preferred_tool": "office.render",
    "prepare_required": false
  },
  "gif": {
    "agent_render_supported": false,
    "image_generation": {
      "fps": {
        "default": 16,
        "max": 24,
        "min": 4,
        "supported": true
      },
      "provider_control": "server",
      "reference_image": {
        "input": "local path or http/https URL; use reference_images array for multiple",
        "invoke_field": "reference_image",
        "invoke_field_array": "reference_images",
        "max_count": 8,
        "supported": true
      },
      "sheet": {
        "frames": 16,
        "grid": "4x4",
        "size": "1024x1024"
      }
    },
    "image_support": {
      "default_enabled": true
    },
    "preferred_tool": "office.generate",
    "prepare_required": false,
    "publish_support": {
      "config_command": "officecli config set-publish",
      "default_publish": true,
      "disable_flag": "--no-publish",
      "publish_supported": true
    }
  },
  "img": {
    "agent_render_supported": false,
    "image_generation": {
      "provider_control": "server",
      "ratio_values": [
        "square",
        "landscape",
        "portrait"
      ],
      "reference_image": {
        "input": "local path or http/https URL; use reference_images array for multiple",
        "invoke_field": "reference_image",
        "invoke_field_array": "reference_images",
        "max_count": 8,
        "supported": true
      },
      "size": {
        "format": "WxH",
        "invoke_field": "size",
        "supported": true
      },
      "templates": {
        "invoke_field": "prompt_template_id",
        "list_method": "image_templates/list",
        "supported": true
      },
      "watermark": {
        "invoke_field": "image_watermark",
        "supported": true
      }
    },
    "image_support": {
      "default_enabled": true
    },
    "preferred_tool": "office.generate",
    "prepare_required": false,
    "publish_support": {
      "config_command": "officecli config set-publish",
      "default_publish": true,
      "disable_flag": "--no-publish",
      "publish_supported": true
    }
  },
  "pptx": {
    "agent_render_supported": true,
    "image_support": {
      "config_command": "officecli config set-generation",
      "config_fields": [
        "image_base_url",
        "image_api_key",
        "image_model"
      ],
      "default_enabled": true,
      "disable_flag": "--no-images",
      "invoke_field": "enable_images",
      "notes": [
        "PPT images always use the hosted image route via account hosted credits; the legacy image_quality / --image-quality field is accepted for backward compat and ignored.",
        "If hosted credits are not configured, the deck is generated without images and a WARN_PPT_PREMIUM_IMAGE_DEGRADED warning is emitted.",
        "If you only want a text-only deck, disable images explicitly."
      ],
      "quality_field": "image_quality (deprecated; accepted and ignored)"
    },
    "payload_schema": {
      "additionalProperties": false,
      "properties": {
        "slides": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "bgColor": {
                "type": "string"
              },
              "bgColor2": {
                "type": "string"
              },
              "chart": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "categories": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "title": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "values": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "title",
                      "type",
                      "categories",
                      "values"
                    ],
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "content": {
                "type": "string"
              },
              "hasImage": {
                "type": "boolean"
              },
              "imagePos": {
                "enum": [
                  "",
                  "right",
                  "left",
                  "background",
                  "center",
                  "top",
                  "bottom",
                  "diagonal"
                ],
                "type": "string"
              },
              "imagePrompt": {
                "type": "string"
              },
              "isTitle": {
                "type": "boolean"
              },
              "layout": {
                "type": "string"
              },
              "metrics": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "value",
                    "note"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "narrativeRole": {
                "type": "string"
              },
              "points": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "sectionIndex": {
                "type": "integer"
              },
              "sectionTitle": {
                "type": "string"
              },
              "sections": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    },
                    "heading": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "heading",
                    "detail"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "source": {
                "type": "string"
              },
              "subtitle": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "variant": {
                "type": "string"
              },
              "visuals": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "caption": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "prompt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "prompt",
                    "caption"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "title",
              "content",
              "isTitle",
              "layout",
              "variant",
              "narrativeRole",
              "sectionIndex",
              "sectionTitle",
              "subtitle",
              "points",
              "sections",
              "chart",
              "metrics",
              "source",
              "bgColor",
              "bgColor2",
              "hasImage",
              "imagePrompt",
              "imagePos",
              "visuals"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "stylePreset": {
          "type": "string"
        },
        "theme": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "accentColor": {
                  "type": "string"
                },
                "backgroundType": {
                  "type": "string"
                },
                "bgColor1": {
                  "type": "string"
                },
                "bgColor2": {
                  "type": "string"
                },
                "eaFontFamily": {
                  "type": "string"
                },
                "fontFamily": {
                  "type": "string"
                },
                "highlightColor": {
                  "type": "string"
                },
                "primaryColor": {
                  "type": "string"
                },
                "textColor": {
                  "type": "string"
                },
                "titleTextColor": {
                  "type": "string"
                }
              },
              "required": [
                "primaryColor",
                "accentColor",
                "highlightColor",
                "backgroundType",
                "bgColor1",
                "bgColor2",
                "textColor",
                "titleTextColor",
                "fontFamily",
                "eaFontFamily"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "stylePreset",
        "theme",
        "slides"
      ],
      "type": "object"
    },
    "pptx_backends": {
      "default": "go-spine",
      "deprecated_alias": "artifact-experimental",
      "failure_mode": "go-spine is the default local PPTX renderer; officegen remains available as a legacy rollback backend.",
      "invoke_field": "pptx_backend",
      "legacy": "officegen",
      "render_notes": "office.render rejects pptx_backend; use office.generate for reference-aware generation with backend selection.",
      "render_tool": "office.generate",
      "supported": true,
      "values": [
        "go-spine",
        "officegen",
        "artifact-experimental"
      ]
    },
    "preferred_tool": "office.render",
    "prepare_required": false,
    "reference_style": {
      "default_recursive_scan": true,
      "disable_flag": "--no-reference-scan",
      "enable_field": "enable_reference_scan",
      "explicit_field": "reference_pptx",
      "explicit_field_array": "reference_pptxs",
      "explicit_flag": "--reference-pptx",
      "invoke_tool": "office.generate",
      "notes": [
        "Reference style learning is available through office.generate and `officecli new pptx`; office.render consumes an already prepared payload and rejects reference scan fields.",
        "PPTX generation recursively scans the invocation working directory by default and summarizes all discovered .pptx files into a compact editable-style profile.",
        "Use enable_reference_scan=false to disable automatic scanning; explicit reference_pptx/reference_pptxs paths can still be supplied.",
        "The style profile is used as intent only; raw PPTX XML, images, and arbitrary low-level style fields are not copied into the prompt."
      ],
      "root_field": "reference_root",
      "root_flag": "--reference-root",
      "supported": true
    }
  },
