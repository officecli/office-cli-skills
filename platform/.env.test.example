APP_ENV=staging
HTTP_ADDR=:8080

SITE_BASE_URL=https://officecli.shimodev.com
PLATFORM_BASE_URL=https://officecli.shimodev.com
GOOGLE_REDIRECT_URL=https://officecli.shimodev.com/api/auth/google/callback
ADMIN_GOOGLE_REDIRECT_URL=https://officecli.shimodev.com/api/admin/auth/google/callback
OAUTH2_REDIRECT_URL=https://officecli.shimodev.com/api/auth/oauth2/callback
ADMIN_OAUTH2_REDIRECT_URL=https://officecli.shimodev.com/api/admin/auth/oauth2/callback

# Company OAuth2/OIDC. Use real testing credentials.
OAUTH2_AUTH_URL=https://oauth.example.com/oauth2/authorize
OAUTH2_TOKEN_URL=https://oauth.example.com/oauth2/token
OAUTH2_USERINFO_URL=https://oauth.example.com/oauth2/userinfo
OAUTH2_CLIENT_ID=replace-with-testing-client-id
OAUTH2_CLIENT_SECRET=replace-with-testing-client-secret
# Optional: use a separate admin OAuth2 client when the OAuth2 server only allows one callback per client.
# Leave empty to reuse OAUTH2_CLIENT_ID/OAUTH2_CLIENT_SECRET for admin.
ADMIN_OAUTH2_CLIENT_ID=
ADMIN_OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPES=openid,profile,email
OAUTH2_SUBJECT_FIELD=sub
OAUTH2_EMAIL_FIELD=email
OAUTH2_NAME_FIELD=name
OAUTH2_AVATAR_FIELD=picture
APP_GOOGLE_ALLOWLIST=*
ADMIN_GOOGLE_ALLOWLIST=luyang950@gmail.com

# Required application secrets. Generate real values before deployment.
ADMIN_PASSWORD=replace-with-admin-password
SESSION_SECRET=replace-with-at-least-32-chars
APP_SESSION_SECRET=replace-with-at-least-32-chars
API_KEY_HASH_SALT=replace-with-hash-salt
API_KEY_ENCRYPTION_KEY=replace-with-base64-32-byte-key
LICENSE_PROOF_SEED=replace-with-base64url-32-byte-seed

# Real testing Hosted LLM upstream.
HOSTED_LLM_BASE_URL=https://aigateway.claudeoffice.com/v1
HOSTED_LLM_API_KEY=replace-with-testing-llm-key
HOSTED_LLM_TEXT_MODEL=gpt-4.1
HOSTED_LLM_IMAGE_MODEL=gpt-image-2
HOSTED_LLM_PROVIDER=openai
AIGATEWAY_ADMIN_BASE_URL=https://aigateway.claudeoffice.com
AIGATEWAY_ADMIN_API_KEY=replace-if-user-key-provisioning-is-tested
AIGATEWAY_API_KEY_GROUP=officecli-test
AIGATEWAY_CREATE_API_KEY_PATH=/api/open/api-keys

# Stripe is intentionally not part of the testing-environment real integration gate.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_SUCCESS_URL=https://officecli.shimodev.com/app/billing?status=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://officecli.shimodev.com/app/billing?status=cancel

OFFICESDK_HOST=
OFFICESDK_ENDPOINT=https://officecli.shimodev.com/sdk/turbo-ai
OFFICESDK_JWT_SECRET=replace-if-officesdk-is-tested

PUBLISH_RATE_LIMIT_PER_MINUTE=30
PUBLISH_MAX_FILE_BYTES=52428800
PUBLISH_DEFAULT_EXPIRE_SECONDS=2592000
